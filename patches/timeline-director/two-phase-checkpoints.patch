+        "streams": [stream.detach().to(device="cpu").contiguous() for stream in streams],
+    }
+
+
+def _restore_checkpoint_stream_state(value, device):
+    if not isinstance(value, dict) or not isinstance(value.get("streams"), list):
+        raise CheckpointError("Checkpoint AV stream state is malformed", 409)
+    streams = value["streams"]
+    if not streams or any(not isinstance(stream, torch.Tensor) for stream in streams):
+        raise CheckpointError("Checkpoint AV tensors are missing", 409)
+    return _pack([stream.to(device) for stream in streams], bool(value.get("nested")))
+
+
+def _checkpoint_tensor_payload(state):
+    buffer = pyio.BytesIO()
+    torch.save(state, buffer)
+    return buffer.getvalue()
+
+
+def resume_progressive_high_resolution(
+    model, positive, negative, latent_image, sampler, sigmas, seed, cfg,
+    transition_step, checkpoint_state, highres_tiling=False, model_hires=None,
+):
+    """Resume the pinned SelfLift high-resolution suffix from a validated checkpoint."""
+    _validate_schedule(sigmas, transition_step)
+    _validate_sampling(model.get_model_object("model_sampling"), sampler)
+    if not checkpoint_state.get("native_av_mask"):
+        raise CheckpointError("Checkpoint does not contain a native H3 AV continuation state", 409)
+
+    expected_streams, expected_nested = _streams(comfy.sample.fix_empty_latent_channels(
+        model, latent_image["samples"], latent_image.get("downscale_ratio_spacial", None),
+        latent_image.get("downscale_ratio_temporal", None)))
+    for name in ("resume_latent", "resume_noise", "high_noise_mask"):
+        value = checkpoint_state.get(name)
+        if (
+            not isinstance(value, dict)
+            or bool(value.get("nested")) != bool(expected_nested)
+            or not isinstance(value.get("streams"), list)
+            or len(value["streams"]) != len(expected_streams)
+        ):
+            raise CheckpointError(f"Checkpoint {name} stream structure does not match this segment", 409)
+        if any(not isinstance(stream, torch.Tensor) for stream in value["streams"]):
+            raise CheckpointError(f"Checkpoint {name} tensor shape does not match this segment", 409)
+        if name == "high_noise_mask":
+            shape_mismatch = any(
+                mask.ndim != expected.ndim
+                or mask.shape[0] != expected.shape[0]
+                or any(size not in (1, target) for size, target in zip(mask.shape[1:], expected.shape[1:]))
+                for mask, expected in zip(value["streams"], expected_streams)
+            )
+        else:
+            shape_mismatch = any(
+                tuple(stream.shape) != tuple(expected.shape)
+                for stream, expected in zip(value["streams"], expected_streams)
+            )
+        if shape_mismatch:
+            raise CheckpointError(f"Checkpoint {name} tensor shape does not match this segment", 409)
+
+    device = comfy.model_management.intermediate_device()
+    resume_latent = _restore_checkpoint_stream_state(checkpoint_state["resume_latent"], device)
+    resume_noise = _restore_checkpoint_stream_state(checkpoint_state["resume_noise"], device)
+    high_noise_mask = _restore_checkpoint_stream_state(checkpoint_state["high_noise_mask"], device)
+    restore_mask = checkpoint_state["video_restore_mask"].to(device)
+    video_anchor = checkpoint_state["video_anchor"].to(device)
+    low_resolution_carry = checkpoint_state["low_resolution_carry"].to(
+        device=comfy.model_management.intermediate_device(),
+        dtype=comfy.model_management.intermediate_dtype(),
+    )
+
+    high_base = model_hires if model_hires is not None else model
+    high_model = h3_tiling.tiled_model(
+        high_base, [tuple(stream.shape) for stream in expected_streams]
+    ) if highres_tiling else high_base
+    high_model = high_model.clone()
+    high_drift_state = high_model.model_options.get(_DRIFT_CONTROL_KEY)
+    if callable(getattr(high_drift_state, "configure_selflift_stage", None)):
+        high_drift_state.configure_selflift_stage(
+            tuple(video_anchor.shape), restore_mask, checkpoint_state["audio_mask"].to(device),
+            hard_lock=False,
+        )
+
+    total_steps = sigmas.shape[-1] - 1
+    evaluations = 0
+    callback = latent_preview.prepare_callback(model, total_steps)
+
+    def callback_high(step, x0, x, total):
+        nonlocal evaluations
+        step = evaluations
+        evaluations += 1
+        if evaluations > total_steps - transition_step:
+            raise RuntimeError("SelfLift: too many resumed high-resolution callbacks")
+        return callback(step + transition_step, x0, x, total_steps)
+
+    out = comfy.samplers.sample(
+        high_model, resume_noise, positive, negative, cfg, model.load_device,
+        sampler, sigmas[transition_step:], high_model.model_options,
+        latent_image=resume_latent, denoise_mask=high_noise_mask,
+        callback=callback_high, disable_pbar=not comfy.utils.PROGRESS_BAR_ENABLED,
+        seed=seed,
+    )
+    if evaluations != total_steps - transition_step:
+        raise RuntimeError(
+            f"SelfLift: expected {total_steps - transition_step} resumed high-resolution callbacks, received {evaluations}"
+        )
+
+    if restore_mask is not None and not callable(
+        getattr(high_drift_state, "configure_selflift_stage", None)
+    ):
+        out_streams, out_nested = _streams(out)
+        mask = restore_mask.to(device=out_streams[0].device, dtype=out_streams[0].dtype).expand_as(out_streams[0])
+        restored = out_streams[0] * mask + video_anchor.to(out_streams[0]) * (1.0 - mask)
+        out = _pack([torch.where(mask == 0, video_anchor.to(out_streams[0]), restored)] + out_streams[1:], out_nested)
+
+    result = latent_image.copy()
+    result.pop(_PREVIOUS_LOW_CARRY_KEY, None)
+    result["samples"] = out.to(
+        device=comfy.model_management.intermediate_device(),
+        dtype=comfy.model_management.intermediate_dtype(),
+    )
+    result[_LOW_CARRY_KEY] = low_resolution_carry
+    return result
+

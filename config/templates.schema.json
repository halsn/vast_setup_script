{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://h3-container.local/schemas/templates.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "templates"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "templates": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/template"
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": { "const": "h3_t2v" }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": { "const": "h3_i2v" }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": { "const": "h3_r2v" }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": { "const": "h3_fast_turbo" }
            }
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    }
  },
  "$defs": {
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "display_name",
        "mode",
        "workflow",
        "required_models",
        "features",
        "min_protocol_version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "enum": ["h3_t2v", "h3_i2v", "h3_r2v", "h3_fast_turbo"]
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "enum": ["t2v", "i2v", "r2v"]
        },
        "workflow": {
          "type": "string",
          "minLength": 1
        },
        "required_models": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "features": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "min_protocol_version": {
          "type": "integer",
          "exclusiveMinimum": 0
        }
      }
    }
  }
}
